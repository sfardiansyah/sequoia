{
  "name": "sequoia",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/index.ts",
    "start:api": "bun apps/api/src/index.ts",
    "sequoia": "bun apps/api/src/cli/index.ts",
    "db:migrate": "bun run sequoia migrate",
    "member:admit": "bun run sequoia member admit",
    "test": "bun test",
    "test:integration": "bun scripts/test-integration.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "check:contracts": "cd contracts && aiken fmt --check && aiken check && aiken build && git diff --exit-code -- plutus.json",
    "test:contracts": "bun test packages/offchain"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}

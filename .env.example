# Local development defaults. Copy to .env and set JWT_PRIVATE_KEYS.
POSTGRES_USER=sequoia
POSTGRES_PASSWORD=sequoia
POSTGRES_DB=sequoia
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000

# Used by `bun run dev:api` on the host.
DATABASE_URL=postgres://sequoia:sequoia@localhost:5432/sequoia

# Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt.pem
#   base64 -w0 jwt.pem
JWT_PRIVATE_KEYS=

# Used by the host-side integration test command.
TEST_DATABASE_URL=postgres://sequoia:sequoia@localhost:5432/sequoia_test
